# GeoDrafts Firebase Configuration Example
# Replace with your actual non-sensitive Firebase project credentials in .env.local

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=geodrafts-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=geodrafts-app
VITE_FIREBASE_STORAGE_BUCKET=geodrafts-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-MEASUREMENTID
